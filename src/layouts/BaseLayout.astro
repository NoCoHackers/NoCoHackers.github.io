---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
</head>
<body>
    <div class="container">
        <div class="terminal-window">
            <slot />
        </div>
    </div>
</body>
</html>

<style is:global>
    @import '../styles/terminal.css';
</style>
